import java_cup.runtime.Symbol;
import java.util.*;
import TablaDeSimbolo;

parser code {:
    public void syntax_error(Symbol s) {
        System.out.println("Error de sintaxis en línea " + (s.left + 1) + ", token: " + s.value);
    }
:};

terminal DATA_TYPE_ASSIGN, ASIGN, SUMA, MULT, DIV, RESTA;
terminal MOD,COMA,PUNTO,POT,PR_WHILE;
terminal DEC_VAR, END_DEC_VAR;
terminal PR_FOR, PR_IS, PR_RANGE, PR_STEP, PR_NEXT, PR_IF, PR_ELSE, PR_ENDIF, PR_REPEAT, PR_UNTIL, PR_PROGRAM,PR_ENDPROGRAM;
terminal PR_INT, PR_FLOAT, PR_STRING, SHOW;
terminal CLASP_A, CLASP_C, PAREN_A, PAREN_C, KEY_A, KEY_C;
terminal IGUAL, MENOR_IGUAL, MAYOR_IGUAL, MENOR, MAYOR, DISTINTO, NOT, AND, OR;
terminal CONST_HEX, CONST_FLOAT, CONST_INT, CONST_STR;
terminal Symbol ID;


non terminal Programa, Declaraciones, Declaracion, Sentencias, Sentencia, Asignacion, Expresion, Termino, Factor,ListaDeclaraciones;
non terminal String Tipo;
non terminal BloqueFor,ProgramaSecundario,Comparacion,BloqueShowEspecial,ExpresionShowEspecial,ExpresionShow, ShowsEspeciales, BloqueIf, BloqueRepeat, BloqueShow, Condicion, OperadorComparacion, ProgramaPrincipal;

start with Programa;

Programa ::=
         Declaraciones ProgramaPrincipal
    | ProgramaSecundario
    ;

Declaraciones ::=
      DEC_VAR ListaDeclaraciones END_DEC_VAR
    ;



ListaDeclaraciones ::=
      ListaDeclaraciones Declaracion
    | Declaracion
    ;


Declaracion ::= ID:id DATA_TYPE_ASSIGN Tipo:t {:
    TablaDeSimbolo.getInstance().addtype(id, t);
:};



Tipo ::=
     PR_INT    {: RESULT = "int";   :}
    | PR_FLOAT  {: RESULT = "float"; :}
    | PR_STRING {: RESULT = "string";:}
    ;


ProgramaPrincipal ::=
    PR_PROGRAM Sentencias PR_ENDPROGRAM
    ;

ProgramaSecundario ::=
    PR_PROGRAM ShowsEspeciales PR_ENDPROGRAM
    ;

ShowsEspeciales ::=
    ShowsEspeciales BloqueShowEspecial
    | BloqueShowEspecial
    ;

BloqueShowEspecial ::=
     SHOW ExpresionShowEspecial
    ;

ExpresionShowEspecial ::=
     CONST_STR
    | CONST_INT
    | CONST_FLOAT
    | CONST_HEX
    ;

Sentencias ::=
      Sentencias Sentencia
    | Sentencia
    ;

Sentencia ::=
      Asignacion
    | BloqueFor
    | BloqueIf
    | BloqueRepeat
    | BloqueShow
    ;

Asignacion ::=
      ID ASIGN Expresion
    ;

Expresion ::=
      Expresion SUMA Termino
    | Expresion RESTA Termino
    | Termino
    ;

Termino ::=
      Termino MULT Factor
    | Termino DIV Factor
    | Factor
    ;

Factor ::=
      PAREN_A Expresion PAREN_C
    | ID
    | CONST_INT
    | CONST_FLOAT
    | CONST_HEX
    | CONST_STR
    ;

BloqueFor ::=
      PR_FOR ID PR_IS PR_RANGE CLASP_A Expresion CLASP_C KEY_A PR_STEP CONST_INT KEY_C Sentencias PR_NEXT ID
    | PR_FOR ID PR_IS PR_RANGE CLASP_A Expresion CLASP_C Sentencias PR_NEXT ID
    ;

BloqueIf ::=
      PR_IF PAREN_A Condicion PAREN_C Sentencias PR_ELSE Sentencias PR_ENDIF
    | PR_IF PAREN_A Condicion PAREN_C Sentencias PR_ENDIF
    ;

BloqueRepeat ::=
      PR_REPEAT Sentencias PR_UNTIL PAREN_A Condicion PAREN_C
    ;

ExpresionShow ::=
     CONST_STR
    | ID
    | CONST_INT
    | CONST_FLOAT
    | CONST_HEX
    ;

BloqueShow ::=
      SHOW ExpresionShow
    ;

Condicion ::=
     NOT PAREN_A Comparacion PAREN_C
    | PAREN_A Comparacion PAREN_C AND PAREN_A Comparacion PAREN_C
    | PAREN_A Comparacion PAREN_C OR PAREN_A Comparacion PAREN_C
    | PAREN_A Comparacion PAREN_C
    | Comparacion
    ;

Comparacion ::=
    Expresion OperadorComparacion Expresion
    ;

OperadorComparacion ::=
      IGUAL
    | MENOR
    | MAYOR
    | MENOR_IGUAL
    | MAYOR_IGUAL
    | DISTINTO
    ;

